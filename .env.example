# Copy to .env and fill in. Never commit .env.

# --- Neo4j / Neo4j AuraDB ---
# Local:  bolt://localhost:7687
# Aura:   neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- LLM (Groq: routing, agents, Cypher generation, synthesis) ---
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- Embeddings (Google Gemini) ---
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the dimension the Neo4j vector index was built with.
# Changing this requires a full re-seed.
EMBEDDING_DIM=768

# --- Deployment ---
# Comma-separated exact origins allowed to call this API.
# Leave blank in local dev to allow localhost only.
ALLOWED_ORIGINS=
# Per-IP queries per UTC day. Protects the LLM billing on a public demo.
DAILY_QUERY_LIMIT=5
# Set false to run without a knowledge graph (agents fall back to web + LLM).
GRAPH_ENABLED=true
LOG_LEVEL=INFO
