# Copy to .env and fill in. Never commit .env.

# --- Neo4j / Neo4j AuraDB ---
# Local:  bolt://localhost:7687
# Aura:   neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Usually "neo4j", but some Aura instances name the database after the instance
# id and reject the default. Copy it from the downloaded credentials file:
# querying the wrong database fails with DatabaseNotFound, not a bad password.
NEO4J_DATABASE=neo4j

# --- LLM (Groq: routing, agents, Cypher generation, synthesis) ---
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- Google Gemini (embeddings, and graph extraction) ---
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Graphiti's entity-extraction prompts run to roughly 19k tokens per episode,
# which exceeds Groq's free 12k tokens-per-minute ceiling in a single request and
# can never succeed there. Set to "groq" only on a paid Groq tier.
GRAPH_LLM_PROVIDER=gemini
# Agents, router, reasoning and Cypher generation. Gemini by default: CrewAI
# strips its cache-breakpoint markers only for natively supported providers,
# and Groq is not one, so crew runs fail there with an 'unsupported property'
# error. Set to "groq" only on a paid Groq tier.
AGENT_LLM_PROVIDER=gemini
GEMINI_MODEL_NAME=gemini-2.5-flash
# Must match the dimension the Neo4j vector index was built with.
# Changing this requires a full re-seed.
EMBEDDING_DIM=768

# --- Deployment ---
# Comma-separated exact origins allowed to call this API.
# Leave blank in local dev to allow localhost only.
ALLOWED_ORIGINS=
# Per-IP queries per UTC day. Protects the LLM billing on a public demo.
DAILY_QUERY_LIMIT=5
# Number of proxies in front of this service. Behind a proxy the caller's address
# can only come from X-Forwarded-For, which the caller also writes, so only the
# right-most entries - the ones our own proxies appended - can be trusted. Render
# terminates TLS at one proxy, hence 1. Use 0 when running the API directly, which
# ignores the header entirely. Too low a value makes every visitor share one
# allowance; too high lets a forged header buy a fresh one.
TRUSTED_PROXY_HOPS=1
# Set false to run without a knowledge graph (agents fall back to web + LLM).
GRAPH_ENABLED=true
LOG_LEVEL=INFO
